# Секреты и настройки. НЕ коммитить!
# На сервере: скопировать в /var/www/tg-text.ru/.env и подставить свои значения.
# Файл .env уже в .gitignore и в репозиторий не попадёт.

# DeepSeek API (обязательно для API и бота)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# Telegram-бот (только для bot.js)
TELEGRAM_BOT_TOKEN=123456:ABC-xxxxxxxx

# БД (если не заданы — используются значения по умолчанию из app.js/bot.js)
DB_HOST=localhost
DB_USER=tg_text_user
DB_PASSWORD=your_db_password
DB_NAME=tg_text_db

# JWT для веб-авторизации
JWT_SECRET=random-long-secret-string
