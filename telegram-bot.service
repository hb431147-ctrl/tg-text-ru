[Unit]
Description=Telegram Bot for Text Processor
After=network.target mysql.service

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/tg-text.ru/api
Environment="NODE_ENV=production"
EnvironmentFile=-/var/www/tg-text.ru/.env
ExecStart=/usr/bin/node bot.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
